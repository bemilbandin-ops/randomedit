{
  "name": "randomedit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "npm run test:run",
    "test:unit": "node --experimental-strip-types --test src/**/*.test.ts",
    "test:ui": "vitest run src/components/AppTutorial.ui.test.tsx --environment jsdom",
    "test:browser-media": "node scripts/browser-media-smoke.mjs",
    "test:run": "npm run test:unit && npm run test:ui"
  },
  "dependencies": {
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
